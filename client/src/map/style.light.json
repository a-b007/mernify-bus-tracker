      "id": "bridge-primary-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all",
        ["==", "brunnel", "bridge"],
        ["any",
          ["==", "class", "primary"],
          ["==", "class", "secondary"],
