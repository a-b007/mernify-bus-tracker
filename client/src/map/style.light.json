          10, 2,
          14, 8,
          18, 28
        ]
      },
      "layout": { "line-join": "round" }
    },
    {
      "id": "bridge-primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all",
        ["==", "brunnel", "bridge"],
        ["any",
          ["==", "class", "primary"],
          ["==", "class", "secondary"],
          ["==", "class", "tertiary"]
        ]
      ],
      "minzoom": 10,
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"],
