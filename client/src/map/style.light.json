        "text-font": ["Noto Sans Regular"],
        "text-size": 10,
        "text-max-width": 8,
        "text-anchor": "top",
        "text-offset": [0, 0.5],
        "text-optional": true
      },
      "paint": {
        "text-color": "#3E4853",
        "text-halo-color": "#F4F6EF",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "place-suburb",
