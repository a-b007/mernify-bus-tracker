      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["==", "class", "suburb"],
      "minzoom": 12,
      "maxzoom": 16,
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
