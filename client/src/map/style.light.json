{
  "version": 8,
  "name": "BusTwin Light",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "glyphs": "https://fonts.openmaptiles.org/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#E9EDE3"
      }
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["any",
        ["==", "class", "grass"],
        ["==", "class", "wood"],
        ["==", "class", "farmland"]
      ],
      "paint": {
        "fill-color": "#D3E0CB",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#D3E0CB",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "landuse-green",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["any",
        ["==", "class", "park"],
        ["==", "class", "cemetery"],
        ["==", "class", "grass"],
        ["==", "class", "recreation_ground"]
      ],
      "paint": {
        "fill-color": "#D3E0CB",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#BCD4D9"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#BCD4D9",
        "line-width": ["interpolate", ["linear"], ["zoom"],
          8, 0.5,
          14, 2,
          18, 4
        ]
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 16,
      "paint": {
        "fill-color": "#DFE4D8",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"],
          16, 0,
          16.5, 0.7
        ]
      }
    },
    {
      "id": "tunnel-minor-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all",
        ["==", "brunnel", "tunnel"],
        ["any",
          ["==", "class", "minor"],
          ["==", "class", "service"],
          ["==", "class", "street"]
        ]
      ],
      "paint": {
        "line-color": "#D5DBCF",
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"],
          12, 0.5,
          16, 6,
          20, 18
        ],
        "line-dasharray": [0.5, 0.25]
      },
      "layout": { "line-join": "round" }
    },
    {
      "id": "tunnel-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all",
        ["==", "brunnel", "tunnel"],
        ["any",
          ["==", "class", "minor"],
          ["==", "class", "service"],
          ["==", "class", "street"]
