      "minzoom": 12,
      "paint": {
        "line-color": "#D5DBCF",
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"],
          12, 0.5,
          16, 6,
          20, 18
        ]
      },
      "layout": { "line-join": "round" }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "openmaptiles",
