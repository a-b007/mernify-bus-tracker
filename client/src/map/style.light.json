      "paint": {
        "text-color": "#5B7A5E",
        "text-halo-color": "#D3E0CB",
        "text-halo-width": 1
      }
    },
    {
      "id": "poi-important",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "filter": ["any",
        ["==", "class", "bus_station"],
        ["==", "subclass", "bus_station"],
        ["==", "subclass", "bus_stop"],
        ["==", "class", "railway"],
        ["==", "subclass", "station"],
        ["==", "subclass", "subway_entrance"],
        ["==", "subclass", "halt"],
        ["==", "class", "aerodrome"],
        ["==", "subclass", "aerodrome"],
        ["==", "subclass", "airport"],
        ["==", "class", "hospital"],
        ["==", "subclass", "hospital"],
        ["==", "class", "college"],
        ["==", "subclass", "college"],
        ["==", "subclass", "university"],
        ["==", "subclass", "mall"],
        ["==", "subclass", "shopping_centre"]
