# MongoDB
MONGODB_URI=mongodb://localhost:27017/bus_twin
DB_NAME=bus_twin

# Server
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h

# API Keys (for simulator/ingest)
INGEST_API_KEY=dev-ingest-key-change-me

# Simulator
FLEET_SIZE=600
TICK_MS=1000
SEND_INTERVAL_MS=2000
TIME_SCALE=1
INGEST_URL=http://localhost:3001/api/ingest/batch

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
INGEST_RATE_LIMIT_MAX=60

# Socket.IO
SOCKET_CORS_ORIGIN=http://localhost:5173

# Storage TTL (seconds)
POSITIONS_TTL=7200
ARRIVALS_TTL=172800
ALERTS_TTL=259200

# Batched write intervals (ms)
STATE_FLUSH_MS=10000
HISTORY_FLUSH_MS=30000
ARRIVAL_FLUSH_MS=5000
ROLLUP_FLUSH_MS=60000

# ETA
ETA_INTERVAL_MS=5000
